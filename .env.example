# ============================================================
# ContractGuard - 环境变量配置模板
# 功能：列出所有需要的环境变量及说明
# 使用：复制此文件为 .env.local 并填入实际值
# ============================================================

# ============================================================
# 数据库 (Supabase PostgreSQL)
# ============================================================
# Supabase 项目连接字符串
# 获取方式：Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Supabase 项目 URL
# 获取方式：Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase 匿名密钥（前端使用）
# 获取方式：Supabase Dashboard → Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role 密钥（后端使用，绕过 RLS）
# 获取方式：Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# AI 服务 (OpenAI / Anthropic Claude)
# ============================================================
# AI 提供商: openai | anthropic
AI_PROVIDER=openai

# AI 模型: gpt-4-turbo-preview | gpt-4o | claude-3-opus-20240229
AI_MODEL=gpt-4-turbo-preview

# OpenAI API 密钥
OPENAI_API_KEY=sk-...

# Anthropic API 密钥 (如果使用Claude)
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# Stripe 支付
# ============================================================
# Stripe 密钥（后端）
# 获取方式：Stripe Dashboard → Developers → API keys → Secret key
STRIPE_SECRET_KEY=sk_test_...

# Stripe 公钥（前端）
# 获取方式：Stripe Dashboard → Developers → API keys → Publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Webhook 签名密钥
# 获取方式：Stripe Dashboard → Developers → Webhooks → 点击endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs
# 获取方式：Stripe Dashboard → Products → 点击产品 → Pricing → Price ID
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_xxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_BUSINESS_PRICE_ID=price_xxxxxxxxxxxxx

# ============================================================
# NextAuth.js 认证
# ============================================================
# 加密密钥 (openssl rand -base64 32 生成)
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# 应用URL
# 开发: http://localhost:3000
# 生产: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# 应用配置
# ============================================================
# 文件上传最大大小 (MB)
UPLOAD_MAX_SIZE_MB=20

# 节点环境
NODE_ENV=development
